{
 "openspec": {
  "package": "@fission-ai/openspec",
  "version": "1.15.0",
  "node_required": ">=20.19.0",
  "node_verified": "v20.20.0",
  "installed_at": "tools/openspec",
  "binary": "tools/openspec/node_modules/.bin/openspec",
  "schema": "factory-autonomous",
  "verified_commands": [
   "openspec --version",
   "openspec --help",
   "openspec schema --help",
   "openspec schema fork spec-driven factory-autonomous",
   "openspec schema validate factory-autonomous",
   "openspec schema which factory-autonomous",
   "openspec templates --schema factory-autonomous",
   "openspec new change <id>",
   "openspec status --change <id>",
   "openspec instructions apply --change <id>",
   "openspec validate --all"
  ]
 },
 "playwright_cli": {
  "package": "@playwright/cli",
  "version": "0.1.22",
  "released": "2026-09-28",
  "node_verified": "v24.22.1",
  "installed_at": "tools/playwright-cli",
  "binary": "tools/playwright-cli/node_modules/.bin/playwright-cli",
  "install": "cd tools/playwright-cli && npm ci",
  "browser": "Chromium from the Playwright cache (~/Library/Caches/ms-playwright); `playwright-cli install-browser` if missing",
  "sandbox": "runs inside the factory sandbox with PLAYWRIGHT_MCP_SANDBOX=false (Chrome's own sandbox cannot start nested)",
  "verified_commands": [
   "open <url>",
   "resize <w> <h>",
   "snapshot",
   "screenshot --filename <path>",
   "console",
   "close"
  ]
 },
 "codex": {
  "package": "@openai/codex",
  "version": "0.160.0",
  "released": "2026-10-01",
  "installed_at": "tools/codex",
  "binary": "tools/codex/node_modules/.bin/codex",
  "install": "cd tools/codex && npm ci",
  "invocation": "codex exec --json --skip-git-repo-check --ephemeral --dangerously-bypass-approvals-and-sandbox -m <model> -C <cwd> -o <file> - (prompt on stdin), inside the factory sandbox",
  "events": [
   "thread.started",
   "item.started",
   "item.completed",
   "turn.completed",
   "turn.failed",
   "error"
  ]
 },
 "opencode": {
  "package": "opencode-ai",
  "version": "1.19.0",
  "released": "2026-10-11",
  "installed_at": "tools/opencode",
  "binary": "tools/opencode/node_modules/.bin/opencode",
  "install": "cd tools/opencode && npm ci",
  "invocation": "opencode run --format json --pure -m <provider/model> <prompt>, OPENCODE_CONFIG and XDG_* per call, inside the factory sandbox",
  "events": [
   "step_start",
   "text",
   "tool_use",
   "step_finish",
   "error"
  ]
 },
 "semgrep": {
  "package": "semgrep (PyPI)",
  "version": "1.180.0",
  "released": "2026-10-07",
  "installed_at": "tools/semgrep",
  "binary": "tools/semgrep/.venv/bin/semgrep",
  "install": "uv sync --project tools/semgrep (uv.lock pins every dependency)",
  "rules": "factory/checks/semgrep/security.yml (local, offline; no registry rules, --metrics=off)",
  "sandbox": "runs as the trusted `sast` check with network none; --baseline-commit {base_sha} reports only new code",
  "verified_commands": [
   "semgrep --version",
   "semgrep scan --config <rules> --baseline-commit <sha> --error --metrics=off --disable-version-check --quiet ."
  ]
 }
}
